{
  "name": "groundcheck",
  "version": "0.1.0",
  "description": "Title and loan-document checks where a value counts only if its cited line prints it. Two checks: lienstack and dscr-check.",
  "license": "MIT",
  "author": "Jacob Lopez",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lienstack": "node src/cli.ts lienstack",
    "dscr": "node src/cli.ts dscr",
    "eval": "node src/cli.ts eval",
    "demo:encompass": "node scripts/encompass-demo.ts",
    "layout-b": "node scripts/layout-b.ts --write",
    "simulate": "node scripts/simulate.ts --write",
    "record": "node scripts/record.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.0",
  "optionalDependencies": {
    "@anthropic-ai/sdk": "0.135.0"
  }
}
